---
interface Props {
  url: string
  rawLabel?: string
}

const { url, rawLabel = 'Open raw prompt' } = Astro.props
---

<div class="prompt-copy not-content" data-prompt-copy>
  <div class="prompt-copy__bar">
    <a href={url} class="prompt-copy__raw" target="_blank" rel="noreferrer">
      {rawLabel}
    </a>
    <span class="prompt-copy__status" data-prompt-status>Loading prompt</span>
    <button class="prompt-copy__button" type="button" data-copy-prompt disabled>
      Copy prompt
    </button>
  </div>
  <textarea
    class="prompt-copy__text"
    data-prompt-text
    readonly
    spellcheck="false"
    aria-label="Generated Radashi replacement prompt">Loading prompt...</textarea>
</div>

<script is:inline define:vars={{ url }}>
  document.querySelectorAll('[data-prompt-copy]').forEach(root => {
    if (root.dataset.promptCopyReady) {
      return
    }
    root.dataset.promptCopyReady = 'true'

    const textarea = root.querySelector('[data-prompt-text]')
    const button = root.querySelector('[data-copy-prompt]')
    const status = root.querySelector('[data-prompt-status]')

    function setStatus(text) {
      status.textContent = text
    }

    function copyWithFallback(text) {
      if (navigator.clipboard) {
        return navigator.clipboard.writeText(text)
      }
      textarea.focus()
      textarea.select()
      document.execCommand('copy')
      textarea.setSelectionRange(0, 0)
      return Promise.resolve()
    }

    fetch(url)
      .then(response => {
        if (!response.ok) {
          throw new Error(`Failed to load prompt: ${response.status}`)
        }
        return response.text()
      })
      .then(prompt => {
        textarea.value = prompt
        button.disabled = false
        setStatus(`${prompt.split('\n').length.toLocaleString()} lines`)
      })
      .catch(error => {
        textarea.value = error.message
        setStatus('Prompt unavailable')
      })

    button.addEventListener('click', () => {
      copyWithFallback(textarea.value)
        .then(() => {
          const originalText = button.textContent
          button.textContent = 'Copied'
          setTimeout(() => {
            button.textContent = originalText
          }, 1500)
        })
        .catch(() => {
          setStatus('Copy failed')
        })
    })
  })
</script>

<style>
  .prompt-copy {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
  }

  .prompt-copy__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .prompt-copy__raw,
  .prompt-copy__button {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-weight: 700;
    line-height: 1;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .prompt-copy__button {
    cursor: pointer;
    margin-left: auto;
  }

  .prompt-copy__button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .prompt-copy__status {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }

  .prompt-copy__text {
    display: block;
    width: 100%;
    min-height: 32rem;
    max-height: 70vh;
    resize: vertical;
    border: 0;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    padding: 1rem;
  }

  @media (max-width: 40rem) {
    .prompt-copy__bar {
      align-items: stretch;
      flex-direction: column;
    }

    .prompt-copy__button {
      margin-left: 0;
    }
  }
</style>
